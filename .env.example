# Copy this file to `.env` in this same folder (sreemr-home-django/) and
# fill in your real values. `.env` is already listed in .gitignore — never
# commit your real credentials.

# --- Supabase (Postgres) --------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection Pooling ->
# mode "Session" -> copy the URI shown.
# IMPORTANT: use the Session pooler (host ending in .pooler.supabase.com),
# NOT the "Direct connection" (host db.YOUR_PROJECT_REF.supabase.co) — the
# direct-connection host only resolves over IPv6, which fails with
# "getaddrinfo failed" on many Windows/home networks. The Session pooler is
# reachable over IPv4 and behaves like a normal single connection (unlike
# the Transaction pooler on port 6543, which doesn't support everything
# Django's migrations rely on).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Cloudflare R2 (S3-compatible object storage) -------------------------
# Cloudflare dashboard -> R2 -> Manage API tokens -> create a token scoped to
# your bucket with "Object Read & Write" permission.
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# The bucket name you created in R2.
R2_BUCKET_NAME=sreemr-homes-media

# Cloudflare dashboard -> R2 -> your bucket -> Settings -> S3 API -> Endpoint
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# The public hostname images are served from — WITHOUT the "https://" prefix.
# Either the bucket's public r2.dev host (R2 -> your bucket -> Settings ->
# Public access -> Enable, then copy the pub-xxxxxxxx.r2.dev host), or a
# custom domain you've connected to the bucket (e.g. media.sreemrhomes.com).
R2_PUBLIC_DOMAIN=pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev


# --- Razorpay ---------------------------------------------------------
# Razorpay dashboard -> Settings -> API Keys. Use a Test key while
# developing; switch to a Live key only on the real production deployment.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret


# --- Django core -----------------------------------------------------
# Leave DEBUG unset (or False) in production — True leaks stack traces and
# settings (including SECRET_KEY) to anyone who triggers a server error.
# Set DEBUG=True only in your local .env for development.
DEBUG=False

# Optional: overrides the fallback dev key baked into settings.py. Generate
# a fresh one for real production use, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_own_random_secret_key
